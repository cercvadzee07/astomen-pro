# Copy to .env.local (and add the same values in Vercel → Settings → Environment Variables).
# Orders and contact-form messages are sent to every channel that is configured.
# With nothing set, the site runs in demo mode and only logs them.

# Telegram: create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail via resend.com (free tier is enough)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=info@astroman.ge
NOTIFY_EMAIL_FROM=Astroman <orders@astroman.ge>
